                "fields": [
                    "meetingDates",
                    "meetingStartDate",
                    "status",
                    "daysRemaining",
                    "hasSepProjections",
                    "currentFedRate",
                    "lastChangeBps",
                    "impliedPauseProbPct",
                    "impliedCut25ProbPct",
                    "impliedCut50ProbPct",
                    "actionSummary",
                    "statementHtml"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "meetingDates": {
                        "label": "Meeting Dates",
