                    },
                    "lastChangeBps": {
                        "label": "Last Change (bps)",
                        "format": "number"
                    },
                    "impliedPauseProbPct": {
                        "label": "Pause %",
                        "format": "number"
                    },
                    "impliedCut25ProbPct": {
                        "label": "Cut 25bps %",
